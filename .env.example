# ─── OKCIB Quote Agent — Environment Variables ────────────────────────────────
# Copy this file to .env and fill in your values

# Anthropic API Key (required for the quoting agent)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Carrier Agent Portal URLs ────────────────────────────────────────────────
# After logging into each portal, copy the URL of the "Start New Quote" page
# Leave blank to use the default public URL

PROGRESSIVE_QUOTE_URL=https://www.progressiveagent.com
GEICO_QUOTE_URL=https://www.geico.com/auto-insurance/states/ok/
MERCURY_QUOTE_URL=https://www.mercuryinsurance.com/agents/oklahoma/okc-insurance-broker-0350514.html
ROOT_QUOTE_URL=https://www.joinroot.com/agents/
LM_QUOTE_URL=https://agents.libertymutual.com/find-an-agent/state/oklahoma/oklahoma-city/okc-insurance-broker_pl_3205990432

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000

# ─── Email Notifications ──────────────────────────────────────────────────────
# Gmail SMTP credentials (use an App Password, not your account password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your-app-password
SUBMISSION_EMAIL=info@okcinsurancebrokers.com

# ─── Dashboard Auth (required to access dashboard/lead APIs) ──────────────────
# Basic auth password for /dashboard.html, /api/quotes, /api/agent, /data.
# Username is ignored — enter any username and this password when prompted.
DASHBOARD_PASSWORD=

# ─── Agency CRM (insurance-ams) Lead Forwarding ───────────────────────────────
# When set, every quote submission is forwarded to the AMS sales pipeline.
# AMS_WEBHOOK_SECRET must match OKCIB_WEBHOOK_SECRET in the AMS .env
AMS_WEBHOOK_URL=https://your-ams-domain.com/api/webhooks/okcib
AMS_WEBHOOK_SECRET=
